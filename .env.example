# ==========================================
# Rafiq Voice Assistant - Environment Variables
# ==========================================

# OpenRouter API Key (Get yours from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Base URL (Default is standard OpenRouter endpoint)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM Model to use on OpenRouter
# Examples:
#   anthropic/claude-3.5-sonnet
#   google/gemini-2.0-flash-001
#   openai/gpt-4o-mini
#   meta-llama/llama-3.3-70b-instruct
#   deepseek/deepseek-chat
LLM_MODEL=anthropic/claude-3.5-sonnet

# Language Selection: 'ar' (Arabic) or 'en' (English)
LANGUAGE=ar

# Server Configuration
HOST=0.0.0.0
PORT=8765

# Speech-To-Text (STT)
# Providers: 'auto' (uses Groq if key exists, else local), 'groq', or 'local'
STT_PROVIDER=auto

# Optional: Groq API Key for ultra-fast Whisper Large-V3 (~200ms latency, free tier at https://console.groq.com)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# Local faster-whisper settings (used when offline or no Groq key)
# Models: tiny / base / small / medium / large-v3-turbo
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
STT_LANGUAGE=ar

# Text-To-Speech Provider
# Options: 'namaa' (NAMAA Egyptian Dialect AI) or 'edge' (Microsoft Edge TTS)
TTS_PROVIDER=namaa
# Voices for edge provider: ar-EG-SalmaNeural (female) / ar-EG-ShakirNeural (male)
TTS_VOICE=ar-EG-SalmaNeural
TTS_VOICE_EN=en-US-ChristopherNeural

# Hugging Face Access Token (Optional: for unlimited ZeroGPU quota on NAMAA model)
# Get a free read token from: https://huggingface.co/settings/tokens
HF_TOKEN=
