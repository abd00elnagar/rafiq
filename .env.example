# ==========================================
# Rafiq Voice Assistant - Environment Variables
# ==========================================

# OpenRouter API Key (Get yours from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Base URL (Default is standard OpenRouter endpoint)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM Model to use on OpenRouter
# Examples:
#   anthropic/claude-3.5-sonnet
#   google/gemini-2.0-flash-001
#   openai/gpt-4o-mini
#   meta-llama/llama-3.3-70b-instruct
#   deepseek/deepseek-chat
LLM_MODEL=anthropic/claude-3.5-sonnet

# Server Configuration
HOST=0.0.0.0
PORT=8765

# Speech-To-Text (faster-whisper)
# Models: tiny / base / small / medium / large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
STT_LANGUAGE=ar

# Text-To-Speech (edge-tts)
# Voices: ar-EG-SalmaNeural (female) / ar-EG-ShakirNeural (male)
TTS_VOICE=ar-EG-SalmaNeural
